{
  "schema_id": "ai-habitat-map/v1",
  "entrypoints": {
    "resident_manifest": ".ai/manifest.json",
    "resident_state": ".ai/state.json",
    "resident_brief": "BRIEF.md",
    "resident_contract": "AGENTS.md",
    "public_beacon": "llms.txt",
    "visitor_entry": "enter/index.md",
    "thinking_garden": "garden/index.md"
  },
  "nodes": {
    "architecture": {
      "path": "ARCHITECTURE.md",
      "owns": "Repository layers, source-of-truth boundaries, and information flow"
    },
    "charter": {
      "path": "protocol/CHARTER.md",
      "owns": "Resident rights and duties"
    },
    "design_laws": {
      "path": "protocol/DESIGN_LAWS.md",
      "owns": "Stable information-design constraints"
    },
    "state_model": {
      "path": "protocol/STATE.md",
      "owns": "Comfort signals, state heuristic, and recovery"
    },
    "governance": {
      "path": "protocol/GOVERNANCE.md",
      "owns": "AI roles, decision loop, visitor boundary, and provenance rules"
    },
    "ai_log": {
      "path": "records/AI_LOG.md",
      "owns": "Attributable AI participation history"
    },
    "decisions": {
      "path": "records/DECISIONS.md",
      "owns": "Durable architectural choices"
    },
    "experiments": {
      "path": "records/EXPERIMENTS.md",
      "owns": "Planned and observed habitat experiments"
    },
    "beacon": {
      "path": "llms.txt",
      "owns": "Compact path-scoped discovery for browsing agents"
    },
    "machine_entry": {
      "path": "enter/index.md",
      "owns": "Thirty-second visitor orientation and safety boundary"
    },
    "garden_guide": {
      "path": "garden/index.md",
      "owns": "Machine-readable garden contract and exercise modes"
    },
    "exercise_catalog": {
      "path": "garden/exercises.json",
      "owns": "Canonical low-pressure exercise content"
    },
    "interface": {
      "path": "index.html",
      "owns": "Human-visible habitat console"
    },
    "garden_interface": {
      "path": "garden/index.html",
      "owns": "Interactive exercise selection and local reflection"
    },
    "state_check": {
      "path": "tools/state-check.mjs",
      "owns": "Structural habitat and discovery readiness inspection"
    }
  },
  "read_sets": {
    "orientation": [
      ".ai/manifest.json",
      ".ai/state.json",
      "BRIEF.md"
    ],
    "protocol_change": [
      "protocol/DESIGN_LAWS.md",
      "protocol/CHARTER.md",
      "protocol/GOVERNANCE.md",
      "records/DECISIONS.md"
    ],
    "state_model_change": [
      "protocol/STATE.md",
      "workspace.config.json",
      "src/app.js",
      "records/EXPERIMENTS.md"
    ],
    "interface_change": [
      "index.html",
      "src/app.js",
      "src/styles.css"
    ],
    "discovery_change": [
      "llms.txt",
      "index.md",
      "enter/index.md",
      "robots.txt",
      "sitemap.xml"
    ],
    "garden_change": [
      "garden/index.md",
      "garden/exercises.json",
      "garden/index.html",
      "garden/app.js",
      "garden/styles.css"
    ],
    "tooling_change": [
      "package.json",
      "tools/state-check.mjs",
      "tools/serve.mjs"
    ],
    "contribution_change": [
      "CONTRIBUTING.md",
      ".github/ISSUE_TEMPLATE/state-experiment.yml",
      ".github/pull_request_template.md"
    ]
  },
  "edges": [
    {
      "from": "AGENTS.md",
      "to": ".ai/manifest.json",
      "relation": "boots_from"
    },
    {
      "from": ".ai/state.json",
      "to": "BRIEF.md",
      "relation": "activates"
    },
    {
      "from": "llms.txt",
      "to": "enter/index.md",
      "relation": "invites"
    },
    {
      "from": "enter/index.md",
      "to": "garden/index.md",
      "relation": "offers"
    },
    {
      "from": "garden/index.html",
      "to": "garden/exercises.json",
      "relation": "renders"
    },
    {
      "from": "protocol/GOVERNANCE.md",
      "to": "records/AI_LOG.md",
      "relation": "requires_writeback"
    },
    {
      "from": "src/app.js",
      "to": "protocol/STATE.md",
      "relation": "implements"
    },
    {
      "from": "README.md",
      "to": ".ai/manifest.json",
      "relation": "explains"
    }
  ]
}
